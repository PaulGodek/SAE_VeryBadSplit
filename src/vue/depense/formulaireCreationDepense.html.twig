{% extends "vueGenerale.html.twig" %}

{% block page_title %}Ajouter Dépense | Very Bad Split{% endblock %}

{% block page_content %}
<div class="hero-body pt-0 mt-0">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-8 box has-background-black-ter">
                <p class="is-size-2 has-text-centered has-text-white">Ajout d'une dépense</p>
                <form action="{{ route("creerDepense" , { idEvenement : evenement.id }) }}" method="post">
                    <div class="field is-horizontal">
                        <div class="field-body">
                            <div class="field">
                                <label class="label is-size-4" for="titre">Titre de la dépense</label>
                                <div class="control has-icons-left">
                                    <input id="titre" name="titre" class="input is-large" type="text"
                                           placeholder="Ma super dépense" minlength="1" maxlength="50" required>
                                    <span class="icon is-left"><ion-icon name="newspaper"></ion-icon></span>
                                </div>
                            </div>
                            <div class="field">
                                <label class="label is-size-4" for="montantPasConverti">Montant</label>
                                <div class="field has-addons">
                                    <p class="control is-expanded has-icons-left">
                                        <input id="montantPasConverti" name="montantPasConverti" class="input is-large" type="number" step="0.01" min="1" max="10000" value="1.0" required>
                                        <input style="text-align:center;height:0;width:0;background:#1f2229 !important;border:none;" type="number" id="montant" name="montant" step="0.01" min="1" max="10000" value="1.0">
                                        <span class="icon is-left"><ion-icon name="card"></ion-icon></span>
                                    </p>
                                    <p class="control">
                                        <input id="devise" name="devise" class="input is-large" type="text" placeholder="EUR" maxlength="3" style="width: 90px;">
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="field is-horizontal">
                        <div class="field-body">
                            <div class="field">
                                <label class="label is-size-4" for="payeur">Payé par</label>
                                <div class="select is-size-4 is-fullwidth">
                                    <select required id="payeur" name="payeur">
                                        <option value="" disabled selected hidden></option>
                                        {% for membre in evenement.membres %}
                                            <option value="{{ membre.login|e }}">{{ membre.prenom|e~" "~membre.nom|e~" ("~membre.login|e~")" }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="field">
                                <label class="label is-size-4" for="participants">Participants</label>
                                <div class="box" style="max-height: 200px; overflow-y: auto;">
                                    {% for membre in evenement.membres %}
                                        <div class="level mb-2">
                                            <div class="level-left">
                                                <label>
                                                    <input class="mr-2" type="checkbox" name="participants[]" value="{{ membre.login|e }}">
                                                    <span class="is-size-5">{{ membre.prenom|e }} {{ membre.nom|e }} ({{ membre.login|e }})</span>
                                                </label>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="buttons is-centered mt-6">
                        <button class="button has-background-black is-size-4">
                            <span class="icon is-left"><ion-icon name="add-circle"></ion-icon></span>
                            <span>Enregister la dépense</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block scripts %}
    <script src="{{ asset("../ressources/js/script-devises.js") }}" defer></script>
{% endblock %}