{% extends "vueGenerale.html.twig" %}

{% block page_title %}{{ evenement.titre }} | Very Bad Split{% endblock %}

{% block page_content %}
<div class="hero-body pt-0 mt-5 is-align-items-stretch">
    <div class="container box has-background-black-ter">
        <div class="columns is-centered">
            <div class="column is-10">
                <div class="container">
                    <div class="has-text-white-ter has-text-centered ">
                        <div class="is-size-2">
                            <span>{{ evenement.titre|e }}</span>
                        </div>
                        <div>
                            <span class="icon"><ion-icon name="time"></ion-icon></span>
                            <span>Date : {{ evenement.date.format('d/m/Y') }}</span>
                            <span class="icon"><ion-icon name="card"></ion-icon></span>
                            <span>Coût total : <span data-textfun="evenement.calculerCoutTotal()">{{ coutTotal|number_format(2) }}€</span></span>
                        </div>
                        <div class="buttons is-centered mt-2">
                            {% if (evenement.estMembre(loginConnecte)) %}
                                <a class="button is-link" href="{{ route('FormulaireMiseAJourEvenement', {idEvenement : evenement.id}) }}">
                                    <span class="icon is-left"><ion-icon name="pencil"></ion-icon></span>
                                    <span>Editer</span>
                                </a>
                                {% if (evenement.estProprietaire(loginConnecte)) %}
                                    <a class="button is-danger" href="{{ route('SupprimerEvenement', {idEvenement : evenement.id}) }}">
                                        <span class="icon is-left"><ion-icon name="trash"></ion-icon></span>
                                        <span>Supprimer</span>
                                    </a>
                                {% else %}
                                    <a class="button is-danger" href="{{ route('QuitterEvenement', {idEvenement : evenement.id}) }}">
                                        <span class="icon is-left"><ion-icon name="person-remove"></ion-icon></span>
                                        <span>Quitter</span>
                                    </a>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    <div class="columns">
                        <div class="column is-half">
                            <div class="has-text-centered">
                                <p class="is-size-4"><strong>Dépenses</strong> (<span data-textvar="evenement.nbDepenses">{{ depenses|length }}</span>)</p>
                                {% if (evenement.estMembre(loginConnecte)) %}
                                    <button class="button has-background-black has-text-white-ter is-size-4" onclick="evenement.toggleFormulaireAjout()">
                                        <span class="icon is-left"><ion-icon name="add-circle"></ion-icon></span>
                                        <span>Ajouter une dépense</span>
                                    </button>
                                    <div id="formulaire-ajout" class="box mt-3" style="display: none;">
                                        <form onsubmit="evenement.ajouterDepense(event); return false;">
                                            <div class="field">
                                                <input class="input" type="text" name="titre" placeholder="Titre de la dépense" required>
                                            </div>
                                            <div class="field">
                                                <input class="input" type="number" step="0.01" name="montant" placeholder="Montant" required>
                                            </div>
                                            <div class="field">
                                                <select class="select is-fullwidth" name="payeur" required>
                                                    <option value="">Qui a payé ?</option>
                                                    {% for membre in evenement.membres %}
                                                        <option value="{{ membre.login }}" {% if membre.login == loginConnecte %}selected{% endif %}>
                                                            {{ membre.prenom }} {{ membre.nom }}
                                                        </option>
                                                    {% endfor %}
                                                </select>
                                            </div>
                                            <div class="field">
                                                <label class="label">Participants :</label>
                                                {% for membre in evenement.membres %}
                                                    <label class="checkbox">
                                                        <input type="checkbox" name="participants" value="{{ membre.login }}" checked>
                                                        {{ membre.prenom }} {{ membre.nom }}
                                                    </label><br>
                                                {% endfor %}
                                            </div>
                                            <div class="field is-grouped">
                                                <button class="button is-link" type="submit">Ajouter</button>
                                                <button class="button" type="button" onclick="evenement.toggleFormulaireAjout()">Annuler</button>
                                            </div>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="mt-5 is-overflow-y-auto scrollable-list pr-3" id="liste-depenses">
                                {{ include('vues/depenses/composants/liste_depenses.html.twig', {evenement: evenement, depenses: depenses, loginConnecte: loginConnecte}) }}
                            </div>
                        </div>
                        <div class="column is-half">
                            <div>
                                <div class="has-text-centered">
                                    <p class="is-size-4"><strong>Membres</strong> (<span data-textvar="evenement.nbMembres">{{ evenement.membres|length }}</span>)</p>
                                    {% if evenement.estMembre(loginConnecte) %}
                                        {% if evenement.estProprietaire(loginConnecte) %}
                                            <a class="button has-background-black has-text-white-ter is-size-4" href="{{ route("afficherFormulaireAjoutMembre", {idEvenement : evenement.id}) }}">
                                                <span class="icon is-left"><ion-icon name="person-add"></ion-icon></span>
                                                <span>Ajouter un membre</span>
                                            </a>
                                        {% else %}
                                            <button disabled class="button has-background-black has-text-white-ter is-size-4">
                                                <span class="icon is-left"><ion-icon name="person-add"></ion-icon></span>
                                                <span>Ajouter un membre</span>
                                            </button>
                                        {% endif %}
                                    {% endif %}
                                </div>
                                <div class="mt-5 has-background-black-ter is-overflow-y-auto scrollable-list pr-3" id="liste-membres">
                                    {{ include('vues/utilisateurs/composants/liste_membres.html.twig', {evenement: evenement, transactions: transactions, loginConnecte: loginConnecte}) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block page_scripts %}
    <script type="module" src="{{ asset('../ressources/js/evenement-reactif.js') }}"></script>
    <script>
        // Initialiser les compteurs et montants
        window.evenementId = {{ evenement.id }};
        
        setTimeout(() => {
            window.evenement.nbDepenses = {{ depenses|length }};
            window.evenement.nbMembres = {{ evenement.membres|length }};
            
            // Initialiser les montants des dépenses avec le bon format (nombre décimal)
            {% for depense in depenses %}
                window.evenement.montantsDepenses[{{ depense.id }}] = {{ depense.montant|number_format(2, '.', '') }};
            {% endfor %}
            // Forcer la mise à jour
            window.evenement.montantsDepenses = {...window.evenement.montantsDepenses};
        }, 100);
    </script>
{% endblock %}