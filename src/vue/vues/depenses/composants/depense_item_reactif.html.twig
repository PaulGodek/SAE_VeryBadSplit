<div class="depense box media">
    <div class="media-content">
        <div class="affichage-depense-{{ depense.id }}">
            <div class="is-size-4">
                <span><strong>{{ depense.titre|e }}</strong></span>
            </div>
            <div class="has-text-left is-size-5">
                <span class="icon is-left"><ion-icon name="time"></ion-icon></span>
                <span>Le {{ depense.date.format('d/m/Y') }}</span>
            </div>
            <div class="has-text-left is-size-5">
                <span class="icon is-left"><ion-icon name="card"></ion-icon></span>
                <span>{{ depense.montant|number_format(2) }}€ payé par {{ depense.payeur.prenom|e~" "~depense.payeur.nom|e }}</span>
            </div>
        </div>
        
        <div id="formulaire-edition-depense-{{ depense.id }}" style="display: none;">
            <form onsubmit="evenement.modifierDepense(event, {{ depense.id }}); return false;">
                <div class="field">
                    <input class="input" type="text" name="titre" value="{{ depense.titre|e }}" required maxlength="50">
                </div>
                <div class="field has-addons">
                    <p class="control is-expanded">
                        <input class="input" type="number" name="montant" value="{{ depense.montant }}" step="0.01" min="1" max="10000" required>
                    </p>
                    <p class="control">
                        <span class="button is-static">€</span>
                    </p>
                </div>
                <div class="field">
                    <select class="select is-fullwidth" name="payeur" required>
                        {% for membre in evenement.membres %}
                            <option value="{{ membre.login }}" {% if depense.estPayeur(membre.login) %}selected{% endif %}>
                                {{ membre.prenom }} {{ membre.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field is-grouped">
                    <button class="button is-link is-small" type="submit">Valider</button>
                    <button class="button is-small" type="button" onclick="evenement.toggleEditionDepense({{ depense.id }})">Annuler</button>
                </div>
            </form>
        </div>
    </div>
    <div class="media-right">
        {% if evenement.estMembre(loginConnecte) %}
            <button class="icon-container button is-ghost" onclick="evenement.toggleEditionDepense({{ depense.id }})">
                <span class="icon pb-3"><ion-icon name="pencil"></ion-icon></span>
            </button>
            <button class="delete" onclick="evenement.supprimerDepense(this)" data-id-depense="{{ depense.id }}"></button>
        {% endif %}
    </div>
</div>